# 비브레이브 API 키 설정
# 이 파일을 복사해서 .env 로 저장하고 실제 키를 입력하세요
# cp .env.example .env

# ── 네이버 오픈 API ───────────────────────────────────────────────────────────
# 발급: https://developers.naver.com/apps
# 등록 시 "데이터랩(쇼핑인사이트)" + "검색" API 체크
# 동일한 키 1세트로 트렌드 + 쇼핑 검색 + 경쟁도 모두 사용 가능
NAVER_CLIENT_ID=발급받은_Client_ID
NAVER_CLIENT_SECRET=발급받은_Client_Secret

# ── 네이버 검색광고 API (키워드 자동 탐색 + 실제 월간 검색수) ─────────────────────
# 발급: https://searchad.naver.com > 도구 > API 사용 관리
NAVER_SEARCH_CLIENT_ID=발급받은_검색_API_Client_ID
NAVER_SEARCH_CLIENT_SECRET=발급받은_검색_API_Client_Secret
NAVER_AD_API_KEY=발급받은_검색광고_API_키
NAVER_AD_SECRET_KEY=발급받은_검색광고_Secret_키
NAVER_AD_CUSTOMER_ID=검색광고_고객ID

# ── 도매매 DB API ─────────────────────────────────────────────────────────────
# 발급: http://domemedb.domeggook.com/index/
# 도매꾹 판매자 계정으로 신청 (Open API: 검색/상세조회, Private API: 발주처리 별도)
DOMEMAE_API_KEY=여기에_도매매_API_키_입력

# ── 도매매 자동발주 (선택 — 사용 시 계정 비밀번호 저장 위험 감수 필요) ────────────
# main.py purchase place --live 사용 시에만 필요. 이머니 사전충전 필수.
# 발주 전용 신규 계정(SNS 로그인 아님, 사업자인증 권장)으로 발급받은 별도 API 키 사용 —
# 소싱용 DOMEMAE_API_KEY와 다른 계정이면 반드시 이 계정 전용 키를 새로 발급받아 넣을 것
# (setOrder 호출시 aid와 id 계정이 일치해야 함, 다르면 INCORRECT_CALL 오류)
DOMEMAE_ORDER_API_KEY=발주_전용_계정으로_발급받은_API_키
DOMEMAE_USER_ID=발주_전용_계정_아이디
DOMEMAE_USER_PW=발주_전용_계정_비밀번호

# ── 네이버 커머스 API (스마트스토어 상품등록 + 주문조회/발송처리) ─────────────────
# 발급: https://apicenter.commerce.naver.com
NAVER_COMMERCE_CLIENT_ID=발급받은_커머스_API_Client_ID
NAVER_COMMERCE_CLIENT_SECRET=발급받은_커머스_API_Client_Secret

# ── Claude API (선택 — 상품명/상세설명 AI 생성. 없으면 템플릿 폴백) ────────────────
# 발급: https://console.anthropic.com
ANTHROPIC_API_KEY=여기에_Anthropic_API_키_입력

# ── Friday 대시보드 로그인 (외부 배포 시 필수 — 미설정이면 인증 없이 열림) ─────────
# Render 등 외부에 올릴 때는 반드시 설정. 로컬(127.0.0.1)에서만 쓸 땐 생략 가능.
FRIDAY_USER=원하는_아이디
FRIDAY_PASSWORD=원하는_비밀번호

# ── 카카오톡 "나에게 보내기" (선택 — 발굴/주문 알림. 사업자등록 불필요) ────────────
# 발급: https://developers.kakao.com (개인 앱 생성 → REST API 키 확인)
# 최초 설정: python3 main.py notify setup
KAKAO_REST_API_KEY=여기에_카카오_REST_API_키_입력
KAKAO_REFRESH_TOKEN=notify_setup으로_발급받은_refresh_token
