# 비브레이브 설정 — 이 파일을 복사해 .env 로 저장하고 값을 채우세요 (cp .env.example .env)
# .env 는 비밀번호·키가 들어 있어 git에 올라가지 않습니다(.gitignore). 메신저·메일로 보내지 말고 직접 옮기세요.
# 값이 비어 있어도 Friday는 켜지지만, 해당 기능은 "설정 안 됨"으로 막힙니다. [필수]는 그 기능을 쓰려면 꼭 있어야 하는 항목.

# ── 네이버 API HUB (검색 + 데이터랩) ──────────────────────────────
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 쇼핑 검색 API는 2026-07-31 종료 — 비워 둬도 됩니다
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ── 네이버 검색광고 API (키워드 탐색·월간 검색수) ────────────────────
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=
NAVER_AD_CUSTOMER_ID=

# ── 네이버 커머스 API (스마트스토어 상품 등록·주문 조회·발송처리) [상품·주문 필수] ──
# 커머스API센터(https://apicenter.commerce.naver.com/) → 내 애플리케이션 → API 호출 IP에
# 이 컴퓨터의 공인 IP를 등록해야 합니다(안 하면 403 GW.IP_NOT_ALLOWED). IP는 api.ipify.org 에서 확인.
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=

# ── 도매꾹/도매매 ───────────────────────────────────────────────
# 상품 조회·검색
DOMEMAE_API_KEY=
# 자동 발주 전용 계정(SNS 로그인 계정 불가). aid는 반드시 이 계정(id)으로 발급된 키여야 합니다.
DOMEMAE_ORDER_API_KEY=
DOMEMAE_USER_ID=
DOMEMAE_USER_PW=

# ── 판매자 정보 ────────────────────────────────────────────────
# [발주 필수] 내 스마트스토어 이름, 16글자 이내 — 도매처가 택배 상자·송장에 도매꾹 대신 찍는 쇼핑몰명.
# 비어 있거나 16글자를 넘으면 발주가 시작 전에 멈춥니다.
SELLER_STORE_NAME=
# 수입산 상품의 수입자 칸에 넣을 판매자 상호(도매처가 수입자를 밝히지 않은 경우)
SELLER_BUSINESS_NAME=
# 고객센터 번호 — 스마트스토어 주소록(상품출고지·반품교환지) 등록 번호와 같아야 합니다.
# 비워 두면 010-0000-0000 더미 번호가 상품에 나가니 꼭 실제 번호를 넣으세요.
CS_PHONE_NUMBER=

# ── 가격 비교 ──────────────────────────────────────────────────
# 11번가 시세(상품 관리의 가격 비교)
ELEVENST_API_KEY=

# ── AI (상세페이지 AI 버전·사진 판독·문구) ─────────────────────────
# Claude 구독으로 쓰는 장기 토큰 — 터미널에서 `claude setup-token` 으로 발급(1년)
CLAUDE_CODE_OAUTH_TOKEN=
# (선택) API 키 방식 대체용. 위 토큰이 있으면 쓰지 않습니다.
ANTHROPIC_API_KEY=
# (선택) 대표이미지 AI 생성용
GEMINI_API_KEY=

# ── 카카오톡 나에게 보내기 (선택 — 발주 실패·주문 알림) ──────────────
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=

# ── 마진 기준 (선택 — 그대로 두면 기본값) ─────────────────────────────────────────────────────────
# 등록 시 목표 마진율(기본 0.20). 바꿀 때만 앞의 # 를 지우고 값을 넣으세요 — 빈 값으로 두면 시작이 실패합니다.
# TARGET_MARGIN=

# ── 화면 서버 (선택) ───────────────────────────────────────────
# 로컬에서만 쓰면 아래는 그대로(앞의 # 유지) 두세요. 다른 컴퓨터에서 접속하게 열 때만 # 를 지우고 채웁니다.
# 값 없이 # 만 지우면(빈 값) 세션이 깨지거나 시작이 실패할 수 있으니, 지울 땐 반드시 값을 넣으세요.
# FRIDAY_USER·FRIDAY_PASSWORD 가 있으면 로그인이 필요해집니다(외부에 열 때 필수).
# FRIDAY_USER=
# FRIDAY_PASSWORD=
# DASHBOARD_SECRET_KEY=
# HOST=
# PORT=
